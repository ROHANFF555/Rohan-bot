# =============================================================================
# Rohan-bot — Environment Variables (নমুনা)
# =============================================================================
# এই ফাইলটা কপি করে `.env` বানান (অথবা Render/Replit-এর Secrets-এ বসান):
#     cp .env.example .env
# `.env` কখনো Git-এ কমিট করবেন না — আসল Key গুলো শুধু নিজের কাছে রাখুন।
# =============================================================================

# ---- বাধ্যতামূলক -------------------------------------------------------------
# BotFather থেকে পাওয়া বট টোকেন
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# অ্যাডমিন টেলিগ্রাম ইউজার আইডি — কমা দিয়ে একাধিক দেওয়া যায়
ADMIN_IDS=123456789

# ---- AI Provider (অন্তত একটা লাগবে) ------------------------------------------
# console.groq.com থেকে ফ্রি Key — একাধিক দিলে Load Balancing হয়
# (GROQ_API_KEY_1, GROQ_API_KEY_2, ... এভাবেও দেওয়া যায়)
GROQ_API_KEY=gsk_your_groq_key_here
# OPENROUTER_API_KEY=openrouter_your_key_here
# CEREBRAS_API_KEY=cerebras_your_key_here

# ---- Phase 48: Real Web Search (ঐচ্ছিক — কিন্তু Browser Search-এর জন্য প্রায় আবশ্যক) ----
# Tavily (https://tavily.com) — LLM-optimized আসল ফুল-টেক্সট সার্চ-ইঞ্জিন, ফ্রি টায়ারে
# মাসে ১,০০০+ কল। Key না দিলে বট করবে না crash — শুধু Browse Search ধীরে পুরোনো
# ফ্রি-চেইনে (DuckDuckGo Instant Answer → Wikipedia) ফেলব্যাক করবে, যা বাংলা
# প্রশ্ন-বাক্যে ("... কে?", "... কত?") প্রায়ই খালি ফল দেয় এবং ব্রেকিং নিউজ/দাম/স্কোর
# ধরতে পারে না। time-sensitive প্রশ্নে ("বর্তমান প্রধানমন্ত্রী কে") এই Key থাকলেই
# সঠিক current উত্তর মেলার সম্ভাবনা সবচেয়ে বেশি।
TAVILY_API_KEY=

# ---- Phase 47: Source Attribution (ঐচ্ছিক — নিচেরগুলোর ডিফল্টই ভালো) ----------
# SOURCE_ATTRIBUTION_ENABLED=true
# SOURCE_ATTRIBUTION_FORMAT=full            # minimal/compact/full/detailed
# SOURCE_ATTRIBUTION_LANG=bn
# SOURCE_ATTRIBUTION_DISABLED_COMMANDS=joke,quote

# ---- মেয়াদ টিউন করতে চাইলে (ঐচ্ছিক) ------------------------------------------
# Phase 48: time-sensitive প্রশ্নের cached উত্তর কত দিন তাজা থাকবে (ডিফল্ট কোডে ৭ দিন)
# TIME_SENSITIVE_KNOWLEDGE_TTL_DAYS=7
